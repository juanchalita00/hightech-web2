      "expectedStatus": 200,
      "canonical": "/automotriz/"
    },
    {
      "path": "/servicios/",
      "expectedStatus": 200,
      "canonical": "/servicios/"
    },
    {
      "path": "/peliculas/",
      "expectedStatus": 200,
      "canonical": "/peliculas/"
    },
    {
      "path": "/peliculas/nanoceramica/",
      "expectedStatus": 200,
      "canonical": "/peliculas/nanoceramica/"
    },
    {
      "path": "/contacto/",
      "expectedStatus": 200,
      "canonical": "/contacto/"
    },
    {
      "path": "/nosotros/",
      "expectedStatus": 200,
      "canonical": "/nosotros/"
    },
    {
      "path": "/guias/",
      "expectedStatus": 200,
      "canonical": "/guias/"
    },
    {
      "path": "/preguntas-frecuentes/",
      "expectedStatus": 200,
      "canonical": "/preguntas-frecuentes/"
