  "notFoundCheck": {
    "path": "/__hightech_404_probe__",
    "expectedStatus": 404
  },
  "redirectFixtureFile": "content/redirect-fixtures.json",
  "deploymentEnvVar": "SMOKE_DEPLOYMENT_ENV"
